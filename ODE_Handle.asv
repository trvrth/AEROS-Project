function out = ODE_Handle(rA0, vA0, DV, thrust, dt, t_final)
 % rA0 and vA0 come from the inital data
% DV is calculated before hand and imported into function
% Thrust will stay constant for now
% dt is the stepsize for the 
mu = 1.32712E+11;
tol = 1e-12; % acceptable tolerance
options = odeset('RelTol', tol, 'AbsTol', tol); % ODE45 options

t_tot = 0;

for i = 1:t_final

	[~ , RV] = ode45(@propagate_2BP, [0 dt], [rA0; vA0], options, mu, thrust);
	r_Af = RV(1:3);
    v_Af = RV(4:6);
	r_A0 = r_Af;
	v_A0 = v_Af + DV;
	t_tot = t_tot + dt;

end

out = (t_tot);

return