function [a, e] = orbit_elements(r, v, mu)
    h = cross(r, v);
    r_norm = sqrt(sum(r.^2, 2));
    v_norm = sqrt(sum(v.^2, 2));
    
    % Specific orbital energy
    energy = (v_norm.^2)/2 - mu ./ r_norm;
    a = -mu ./ (2 * energy);
    
    % Eccentricity vector
    e_vec = (cross(v, h) ./ mu) - (r ./ r_norm);
    e = sqrt(sum(e_vec.^2, 2));
    
end
